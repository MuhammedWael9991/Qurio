<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    >

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/streak_days_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Sunday -->
        <FrameLayout
            android:id="@+id/sunday_glow"
            android:layout_width="60dp"
            android:layout_height="70dp"
            app:layout_constraintTop_toTopOf="@id/sunday_container"
            app:layout_constraintStart_toStartOf="@id/sunday_container"
            app:layout_constraintEnd_toEndOf="@id/sunday_container"
            app:layout_constraintBottom_toBottomOf="@id/sunday_container"
            android:background="@drawable/orange_glow"
            android:visibility="gone"
            />
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/sunday_container"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintWidth_percent="0.12"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/monday_container"
            >

            <FrameLayout
                android:id="@+id/sunday_checkmark"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/streak_day_background">

                <ImageView
                    android:id="@+id/sunday_flame"
                    android:src="@drawable/flame"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:layout_marginHorizontal="6dp"
                    android:layout_marginTop="3dp"
                    android:layout_marginBottom="2dp"
                    android:visibility="gone" />
            </FrameLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
        <TextView
            style="@style/Typography.label.xsmall"
            android:text="@string/s"
            android:textColor="@color/Shade_Tertiary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/sunday_container"
            app:layout_constraintStart_toStartOf="@id/sunday_container"
            app:layout_constraintEnd_toEndOf="@id/sunday_container"
            android:layout_marginTop="2dp"/>

        <!-- Monday -->
        <FrameLayout
            android:id="@+id/monday_glow"
            android:layout_width="60dp"
            android:layout_height="70dp"
            app:layout_constraintTop_toTopOf="@id/monday_container"
            app:layout_constraintStart_toStartOf="@id/monday_container"
            app:layout_constraintEnd_toEndOf="@id/monday_container"
            app:layout_constraintBottom_toBottomOf="@id/monday_container"
            android:background="@drawable/orange_glow"
            android:visibility="gone"
            />
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/monday_container"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintWidth_percent="0.12"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/sunday_container"
            app:layout_constraintEnd_toStartOf="@id/tuesday_container"
            >

            <FrameLayout
                android:id="@+id/monday_checkmark"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/streak_day_background">

                <ImageView
                    android:id="@+id/monday_flame"
                    android:src="@drawable/flame"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:layout_marginHorizontal="6dp"
                    android:layout_marginTop="3dp"
                    android:layout_marginBottom="2dp"
                    android:visibility="gone" />
            </FrameLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
        <TextView
            style="@style/Typography.label.xsmall"
            android:text="@string/m"
            android:textColor="@color/Shade_Tertiary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/monday_container"
            app:layout_constraintStart_toStartOf="@id/monday_container"
            app:layout_constraintEnd_toEndOf="@id/monday_container"
            android:layout_marginTop="2dp"/>

        <!-- Tuesday -->
        <FrameLayout
            android:id="@+id/tuesday_glow"
            android:layout_width="60dp"
            android:layout_height="70dp"
            app:layout_constraintTop_toTopOf="@id/tuesday_container"
            app:layout_constraintStart_toStartOf="@id/tuesday_container"
            app:layout_constraintEnd_toEndOf="@id/tuesday_container"
            app:layout_constraintBottom_toBottomOf="@id/tuesday_container"
            android:background="@drawable/orange_glow"
            android:visibility="gone"
            />
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/tuesday_container"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintWidth_percent="0.12"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/monday_container"
            app:layout_constraintEnd_toStartOf="@id/wednesday_container"
            >

            <FrameLayout
                android:id="@+id/tuesday_checkmark"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/streak_day_background">

                <ImageView
                    android:id="@+id/tuesday_flame"
                    android:src="@drawable/flame"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:layout_marginHorizontal="6dp"
                    android:layout_marginTop="3dp"
                    android:layout_marginBottom="2dp"
                    android:visibility="gone" />
            </FrameLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
        <TextView
            style="@style/Typography.label.xsmall"
            android:text="@string/t"
            android:textColor="@color/Shade_Tertiary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/tuesday_container"
            app:layout_constraintStart_toStartOf="@id/tuesday_container"
            app:layout_constraintEnd_toEndOf="@id/tuesday_container"
            android:layout_marginTop="2dp"/>

        <!-- Wednesday -->
        <FrameLayout
            android:id="@+id/wednesday_glow"
            android:layout_width="60dp"
            android:layout_height="70dp"
            app:layout_constraintTop_toTopOf="@id/wednesday_container"
            app:layout_constraintStart_toStartOf="@id/wednesday_container"
            app:layout_constraintEnd_toEndOf="@id/wednesday_container"
            app:layout_constraintBottom_toBottomOf="@id/wednesday_container"
            android:background="@drawable/orange_glow"
            android:visibility="gone"
            />
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/wednesday_container"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintWidth_percent="0.12"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/tuesday_container"
            app:layout_constraintEnd_toStartOf="@id/thursday_container"
            >

            <FrameLayout
                android:id="@+id/wednesday_checkmark"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/streak_day_background">

                <ImageView
                    android:id="@+id/wednesday_flame"
                    android:src="@drawable/flame"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:layout_marginHorizontal="6dp"
                    android:layout_marginTop="3dp"
                    android:layout_marginBottom="2dp"
                    android:visibility="gone" />
            </FrameLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
        <TextView
            style="@style/Typography.label.xsmall"
            android:text="@string/w"
            android:textColor="@color/Shade_Tertiary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/wednesday_container"
            app:layout_constraintStart_toStartOf="@id/wednesday_container"
            app:layout_constraintEnd_toEndOf="@id/wednesday_container"
            android:layout_marginTop="2dp"/>

        <!-- Thursday -->
        <FrameLayout
            android:id="@+id/thursday_glow"
            android:layout_width="60dp"
            android:layout_height="70dp"
            app:layout_constraintTop_toTopOf="@id/thursday_container"
            app:layout_constraintStart_toStartOf="@id/thursday_container"
            app:layout_constraintEnd_toEndOf="@id/thursday_container"
            app:layout_constraintBottom_toBottomOf="@id/thursday_container"
            android:background="@drawable/orange_glow"
            android:visibility="gone"
            />
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/thursday_container"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintWidth_percent="0.12"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/wednesday_container"
            app:layout_constraintEnd_toStartOf="@id/friday_container"
            >

            <FrameLayout
                android:id="@+id/thursday_checkmark"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/streak_day_background">

                <ImageView
                    android:id="@+id/thursday_flame"
                    android:src="@drawable/flame"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:layout_marginHorizontal="6dp"
                    android:layout_marginTop="3dp"
                    android:layout_marginBottom="2dp"
                    android:visibility="gone" />
            </FrameLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
        <TextView
            style="@style/Typography.label.xsmall"
            android:text="@string/t"
            android:textColor="@color/Shade_Tertiary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/thursday_container"
            app:layout_constraintStart_toStartOf="@id/thursday_container"
            app:layout_constraintEnd_toEndOf="@id/thursday_container"
            android:layout_marginTop="2dp"/>

        <!-- Friday -->
        <FrameLayout
            android:id="@+id/friday_glow"
            android:layout_width="60dp"
            android:layout_height="70dp"
            app:layout_constraintTop_toTopOf="@id/friday_container"
            app:layout_constraintStart_toStartOf="@id/friday_container"
            app:layout_constraintEnd_toEndOf="@id/friday_container"
            app:layout_constraintBottom_toBottomOf="@id/friday_container"
            android:background="@drawable/orange_glow"
            android:visibility="gone"
            />
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/friday_container"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintWidth_percent="0.12"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/thursday_container"
            app:layout_constraintEnd_toStartOf="@id/saturday_container"
            >

            <FrameLayout
                android:id="@+id/friday_checkmark"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/streak_day_background">

                <ImageView
                    android:id="@+id/friday_flame"
                    android:src="@drawable/flame"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:layout_marginHorizontal="6dp"
                    android:layout_marginTop="3dp"
                    android:layout_marginBottom="2dp"
                    android:visibility="gone" />
