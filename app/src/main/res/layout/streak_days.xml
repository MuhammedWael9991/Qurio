            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/friday_container"
            app:layout_constraintStart_toStartOf="@id/friday_container"
            app:layout_constraintEnd_toEndOf="@id/friday_container"
            android:layout_marginTop="2dp"/>

        <!-- Saturday -->
        <FrameLayout
            android:id="@+id/saturday_glow"
            android:layout_width="60dp"
            android:layout_height="70dp"
            app:layout_constraintTop_toTopOf="@id/saturday_container"
            app:layout_constraintStart_toStartOf="@id/saturday_container"
            app:layout_constraintEnd_toEndOf="@id/saturday_container"
            app:layout_constraintBottom_toBottomOf="@id/saturday_container"
            android:background="@drawable/orange_glow"
            android:visibility="gone"
            android:layout_marginTop="4dp"
            />
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/saturday_container"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintWidth_percent="0.12"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/friday_container"
            app:layout_constraintEnd_toEndOf="parent"
            >

            <FrameLayout
                android:id="@+id/saturday_checkmark"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/streak_day_background">

                <ImageView
                    android:id="@+id/saturday_flame"
                    android:src="@drawable/flame"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:layout_marginHorizontal="6dp"
                    android:layout_marginTop="3dp"
                    android:layout_marginBottom="2dp"
                    android:visibility="gone" />
            </FrameLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
        <TextView
            style="@style/Typography.label.xsmall"
            android:text="@string/s"
            android:textColor="@color/Shade_Tertiary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/saturday_container"
            app:layout_constraintStart_toStartOf="@id/saturday_container"
            app:layout_constraintEnd_toEndOf="@id/saturday_container"
            android:layout_marginTop="2dp"/>




    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
