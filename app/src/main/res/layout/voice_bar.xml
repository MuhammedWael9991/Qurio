<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    >

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:gravity="center"
        >

        <ImageView
            android:id="@+id/icon"
            android:src="@drawable/ic_voice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            />

        <TextView
            android:id="@+id/title"
            style="@style/Typography.body.small"
            android:textColor="@color/Shade_Secondary"
            android:text="@string/sound"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            />

    </LinearLayout>

    <ImageView
        android:id="@+id/sound_bar_background"
        android:src="@drawable/sound_bar_background"
        android:layout_width="130dp"
        android:layout_height="18dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginEnd="4dp"
        />
    
    <com.qurio.ui.components.SoundBar
        android:id="@+id/sound_bar"
        android:layout_width="115dp"
        android:layout_height="10dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="@id/sound_bar_background"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginStart="4dp"
        />

    <ImageView
        android:src="@drawable/ic_minus"
        android:layout_width="10dp"
        android:layout_height="10dp"
        app:layout_constraintStart_toStartOf="@id/sound_bar_background"
        app:layout_constraintTop_toTopOf="@id/sound_bar_background"
        app:layout_constraintBottom_toBottomOf="@id/sound_bar_background"
        android:layout_marginStart="8dp"
        />

    <ImageView
        android:src="@drawable/ic_plus"
        android:layout_width="10dp"
        android:layout_height="10dp"
        app:layout_constraintEnd_toEndOf="@id/sound_bar_background"
        app:layout_constraintTop_toTopOf="@id/sound_bar_background"
        app:layout_constraintBottom_toBottomOf="@id/sound_bar_background"
        android:layout_marginEnd="8dp"
        />

    <ImageView
        android:id="@+id/sound_indicator"
        android:src="@drawable/sound_indicator"
        android:layout_width="28dp"
        android:layout_height="28dp"
        app:layout_constraintTop_toTopOf="@id/sound_bar"
        app:layout_constraintBottom_toBottomOf="@id/sound_bar"
        app:layout_constraintStart_toEndOf="@id/sound_bar"
        app:layout_constraintEnd_toEndOf="@id/sound_bar"
        />


</androidx.constraintlayout.widget.ConstraintLayout>