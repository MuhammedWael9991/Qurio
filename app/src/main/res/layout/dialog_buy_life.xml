<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/buy_life"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/dialog_character_bg"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/life_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="106dp"
            android:orientation="horizontal"
            android:gravity="center"
            >

            <TextView
                style="@style/Typography.headline.large"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/On_primary"
                android:text="1"
                android:layout_gravity="center_vertical"
                />
            
            <ImageView
                android:src="@drawable/ic_life"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="10dp"
                />

            <TextView
                style="@style/Typography.headline.large"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/On_primary"
                android:text="@string/equals"
                android:layout_gravity="center_vertical"
                android:layout_marginHorizontal="19dp"
                />

            <TextView
                style="@style/Typography.headline.large"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/On_primary"
                android:text="200 X"
                android:layout_gravity="center_vertical"
                />

            <ImageView
                android:src="@drawable/ic_life"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="10dp"
                />


        </LinearLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/button_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/life_container"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginBottom="36dp"
            android:layout_marginTop="36dp"
            android:layout_marginHorizontal="12dp"
            android:visibility="visible"
            >
            <FrameLayout
                android:id="@+id/buy"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintDimensionRatio="3.5:1"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/cancel"
                android:background="@drawable/primary_button_bg"
                >

                <TextView
                    style="@style/Typography.label.large"
                    android:id="@+id/buy_txt"
                    android:text="@string/buy"
                    android:textColor="@color/On_primary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    />

            </FrameLayout>

            <FrameLayout
                android:id="@+id/cancel"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintDimensionRatio="3.5:1"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toEndOf="@id/buy"
                app:layout_constraintEnd_toEndOf="parent"
                android:background="@drawable/button_outlined"
                android:layout_marginStart="8dp"
                >

                <TextView
                    style="@style/Typography.label.large"
                    android:id="@+id/cancel_buy_txt"
                    android:text="@string/cancel"
                    android:textColor="@color/Primary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    />

            </FrameLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>


    </androidx.constraintlayout.widget.ConstraintLayout>
    <!--  Exit Button  -->
    <ImageView
        android:id="@+id/exit_button"
        android:src="@drawable/exit_corner"
        android:layout_width="22dp"
        android:layout_height="26dp"
        app:layout_constraintTop_toTopOf="@id/buy_life"
        app:layout_constraintEnd_toEndOf="parent"
        />

    <ImageView
        android:id="@+id/header"
        android:src="@drawable/lastgame_header"
        android:layout_width="wrap_content"
        android:layout_height="60dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        />

    <TextView
        style="@style/Typography.title.small"
        android:textColor="@color/On_primary"
        android:id="@+id/header_text"
        android:text="@string/buy_life"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="@id/header"
        app:layout_constraintStart_toStartOf="@id/header"
        app:layout_constraintEnd_toEndOf="@id/header"
        app:layout_constraintBottom_toBottomOf="@id/header"
        android:layout_marginBottom="14dp"
        />

</androidx.constraintlayout.widget.ConstraintLayout>