<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:background="@drawable/question_container"
        android:layout_marginTop="22dp"
        >

        <TextView
            android:id="@+id/question_text"
            style="@style/Typography.body.medium"
            android:textColor="@color/Shade_Primary"
            android:text="TODO"
            tools:text="Which of the following best explains how a country’s physical geography can influence its level of economic development?"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/question_image"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:gravity="center"
            android:layout_marginBottom="52dp"
            android:layout_marginTop="8dp"
            />

        <ImageView
            android:id="@+id/question_image"
            android:src="@drawable/question_image"
            android:layout_width="321dp"
            android:layout_height="107dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="50dp"
            />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <ImageView
        android:id="@+id/question_header"
        android:src="@drawable/lastgame_header"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        />

    <TextView
        android:id="@+id/question_number"
        style="@style/Typography.title.small"
        android:textColor="@color/On_primary"
        android:text="Q 1/12"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="@id/question_header"
        app:layout_constraintStart_toStartOf="@id/question_header"
        app:layout_constraintEnd_toEndOf="@id/question_header"
        app:layout_constraintBottom_toBottomOf="@id/question_header"
        android:layout_marginBottom="11dp"
        />


</androidx.constraintlayout.widget.ConstraintLayout>