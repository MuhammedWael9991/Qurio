<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/achievement_dialog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:background="@drawable/dialog_character_bg"
        android:layout_marginTop="16dp"
        >

        <!-- achievement -->
        <include
            android:id="@+id/achievement_list"
            layout="@layout/layout_achievement_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="52dp"
            android:layout_marginHorizontal="4dp"
            android:visibility="visible"
            />

        <FrameLayout
            android:id="@+id/ok_button"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintDimensionRatio="6.5:1"
            app:layout_constraintTop_toBottomOf="@id/achievement_list"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginBottom="36dp"
            android:layout_marginTop="24dp"
            android:layout_marginHorizontal="12dp"
            android:background="@drawable/button_outlined"
            android:visibility="gone"
            >

            <TextView
                style="@style/Typography.label.large"
                android:id="@+id/ok_text"
                android:text="@string/ok"
                android:textColor="@color/Primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                />

        </FrameLayout>

        <!-- details -->
        <include
            android:id="@+id/achievement_details"
            layout="@layout/layout_achievement_details"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="12dp"
            android:visibility="gone"
            />
        <FrameLayout
            android:id="@+id/ok_details_button"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintDimensionRatio="6.5:1"
            app:layout_constraintTop_toBottomOf="@id/achievement_details"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginBottom="36dp"
            android:layout_marginTop="62dp"
            android:layout_marginHorizontal="12dp"
            android:background="@drawable/button_outlined"
            android:visibility="gone"
            >

            <TextView
                style="@style/Typography.label.large"
                android:id="@+id/ok_details_text"
                android:text="@string/ok"
                android:textColor="@color/Primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                />

        </FrameLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/share_ok_buttons_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/achievement_details"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginTop="73dp"
            android:layout_marginBottom="32dp"
            android:layout_marginHorizontal="12dp"
            android:visibility="gone"
            >

            <LinearLayout
                android:id="@+id/share_button"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintDimensionRatio="3.5:1"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/ok_details_own_button"
                android:background="@drawable/primary_button_bg"
                android:gravity="center"
                android:orientation="horizontal"
                >

                <TextView
                    style="@style/Typography.label.large"
                    android:textColor="@color/On_primary"
                    android:text="@string/share_with_friends"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginEnd="8dp"
                    />

                <ImageView
                    android:src="@drawable/ic_share"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    />

            </LinearLayout>
            <FrameLayout
                android:id="@+id/ok_details_own_button"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintDimensionRatio="3.5:1"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toEndOf="@id/share_button"
                app:layout_constraintEnd_toEndOf="parent"
                android:background="@drawable/button_outlined"
                android:layout_marginStart="8dp"
                >

                <TextView
                    style="@style/Typography.label.large"
                    android:id="@+id/ok_buy_text"
                    android:text="@string/ok"
                    android:textColor="@color/Primary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    />

            </FrameLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>


    </androidx.constraintlayout.widget.ConstraintLayout>

    <!--  Exit Button  -->
    <ImageView
        android:id="@+id/exit_button"
        android:src="@drawable/exit_corner"
        android:layout_width="22dp"
        android:layout_height="26dp"
        app:layout_constraintTop_toTopOf="@id/achievement_dialog"
        app:layout_constraintEnd_toEndOf="parent"
        />

    <ImageView
        android:id="@+id/header"
        android:src="@drawable/lastgame_header"
        android:layout_width="wrap_content"
        android:layout_height="60dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        />

    <TextView
        style="@style/Typography.title.small"
        android:textColor="@color/On_primary"
        android:id="@+id/header_text"
        android:text="@string/achievements"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="@id/header"
        app:layout_constraintStart_toStartOf="@id/header"
        app:layout_constraintEnd_toEndOf="@id/header"
        app:layout_constraintBottom_toBottomOf="@id/header"
        android:layout_marginBottom="14dp"
        />

</androidx.constraintlayout.widget.ConstraintLayout>