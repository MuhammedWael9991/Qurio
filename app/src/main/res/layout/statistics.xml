<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/statistics"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    >

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="12dp"
        >

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/lives_holder"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/statstics_small_left"
            app:layout_constraintDimensionRatio="2:1"
            app:layout_constraintEnd_toStartOf="@id/middle"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <View
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:background="@drawable/bottom_rectangle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:layout_marginBottom="1dp"
                android:layout_marginHorizontal="24dp"
                />

            <TextView
                android:id="@+id/lives_title"
                android:text="@string/lives"
                style="@style/Typography.label.xsmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toTopOf="@id/lives_value"
                android:layout_marginBottom="8dp"
                />

            <LinearLayout
                android:id="@+id/lives_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:layout_marginBottom="8dp"
                >

                <ImageView
                    android:contentDescription="@string/lives"
                    android:textColor="@color/Shade_Tertiary"
                    android:src="@drawable/ic_lives_coin"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="4dp"
                    />

                <TextView
                    android:id="@+id/lives"
                    style="@style/Typography.label.medium"
                    android:textColor="@color/Shade_Primary"
                    android:text="4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    />

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/middle"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintDimensionRatio="2:1"
            app:layout_constraintHorizontal_weight="1.2"
            android:background="@drawable/statstics_big_middle"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@id/lives_holder"
            app:layout_constraintEnd_toStartOf="@id/awards_holder"
            >

            <View
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:background="@drawable/bottom_rectangle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:layout_marginHorizontal="38dp"
                />

            <TextView
                android:id="@+id/points_title"
                android:text="@string/points"
                style="@style/Typography.label.xsmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintBottom_toTopOf="@id/points_value"
                android:layout_marginBottom="8dp"
                />

            <LinearLayout
                android:id="@+id/points_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:layout_marginBottom="8dp"
                >

                <ImageView
                    android:contentDescription="@string/points"
                    android:textColor="@color/Shade_Tertiary"
                    android:src="@drawable/ic_coins"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="4dp"
                    />

                <TextView
                    android:id="@+id/points"
                    style="@style/Typography.label.medium"
                    android:textColor="@color/Shade_Primary"
                    android:text="5,400"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    />

            </LinearLayout>


        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/awards_holder"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintDimensionRatio="2:1"
            app:layout_constraintHorizontal_weight="1"
            android:background="@drawable/statstics_small_right"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/middle"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginTop="16dp"
            >

            <View
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:background="@drawable/bottom_rectangle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:layout_marginBottom="1dp"
                android:layout_marginHorizontal="24dp"
                />

            <TextView
                android:id="@+id/Awards_title"
                android:text="@string/awards"
                style="@style/Typography.label.xsmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toTopOf="@id/Awards_value"
                android:layout_marginBottom="8dp"
                />

            <LinearLayout
                android:id="@+id/Awards_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:layout_marginBottom="8dp"
                >

                <ImageView
                    android:contentDescription="@string/awards"
                    android:textColor="@color/Shade_Tertiary"
                    android:src="@drawable/ic_cup"
                    android:layout_width="22dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="4dp"
                    />

                <TextView
                    android:id="@+id/awards"
                    style="@style/Typography.label.medium"
                    android:textColor="@color/Shade_Primary"
                    android:text="2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    />

                <ImageView
                    android:contentDescription="@string/awards"
                    android:textColor="@color/Shade_Tertiary"
                    android:src="@drawable/icon_blue_arrow_right"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="4dp"
                    />

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <ImageView
        android:id="@+id/elite_badge"
        android:contentDescription="@string/points"
        android:src="@drawable/ic_crown"
        android:layout_width="24dp"
        android:layout_height="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginBottom="74dp"
        android:visibility="visible"
        />

    <ImageView
        android:id="@+id/buy_live_icon"
        android:src="@drawable/ic_buy_life"
        android:layout_width="24dp"
        android:layout_height="24dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="30dp"
        />

</androidx.constraintlayout.widget.ConstraintLayout>