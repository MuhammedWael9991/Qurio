<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/setting_dialog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:background="@drawable/dialog_settings_background"
        android:layout_marginVertical="16dp"
        >
        <!--  Exit Button  -->
        <ImageView
            android:id="@+id/exit_button"
            android:src="@drawable/exit_corner"
            android:layout_width="22dp"
            android:layout_height="26dp"
            app:layout_constraintTop_toTopOf="@id/setting_dialog"
            app:layout_constraintEnd_toEndOf="parent"
            />
        
        <com.qurio.ui.components.SoundControl
            android:id="@+id/sound_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:soundTitle="@string/sound"
            app:soundIcon="@drawable/ic_voice"
            app:soundLevel="0.8"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="41dp"
            />

        <com.qurio.ui.components.SoundControl
            android:id="@+id/music_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:soundTitle="@string/music"
            app:soundIcon="@drawable/ic_music"
            app:soundLevel="0.8"
            app:layout_constraintTop_toBottomOf="@id/sound_bar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="26dp"
            />

        <ImageView
            android:id="@+id/divider"
            android:src="@drawable/divider"
            android:layout_width="match_parent"
            android:layout_height="10dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/music_bar"
            android:layout_marginTop="28dp"
            android:layout_marginHorizontal="12dp"
            />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@+id/divider"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="36dp"
            >

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/confirm_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:visibility="visible"
                android:layout_marginHorizontal="12dp"
                >
                <FrameLayout
                    android:id="@+id/save_button"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:layout_constraintDimensionRatio="3.5:1"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/discard_button"
                    android:background="@drawable/primary_button_bg"
                    >

                    <TextView
                        style="@style/Typography.label.large"
                        android:id="@+id/confirm_text"
                        android:text="@string/save_changes"
                        android:textColor="@color/On_primary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        />

                </FrameLayout>

                <FrameLayout
                    android:id="@+id/discard_button"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:layout_constraintDimensionRatio="3.5:1"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toEndOf="@id/save_button"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:background="@drawable/button_outlined"
                    android:layout_marginStart="8dp"
                    >

                    <TextView
                        style="@style/Typography.label.large"
                        android:id="@+id/cancel_text"
                        android:text="@string/discard"
                        android:textColor="@color/Primary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        />

                </FrameLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </LinearLayout>


    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- header -->
    <ImageView
        android:id="@+id/header"
        android:src="@drawable/lastgame_header"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        />
    <TextView
        style="@style/Typography.title.small"
        android:text="Settings"
        android:textColor="@color/On_primary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="@id/header"
        app:layout_constraintStart_toStartOf="@id/header"
        app:layout_constraintBottom_toBottomOf="@id/header"
        app:layout_constraintEnd_toEndOf="@id/header"
        android:layout_marginBottom="14dp"
        />

</androidx.constraintlayout.widget.ConstraintLayout>