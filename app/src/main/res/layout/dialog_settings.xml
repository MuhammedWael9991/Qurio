<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:background="@drawable/dialog_settings_background"
        android:layout_marginVertical="16dp"
        >
        
        <com.qurio.ui.components.SoundControl
            android:id="@+id/sound_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:soundTitle="@string/sound"
            app:soundIcon="@drawable/ic_voice"
            app:soundLevel="0.8"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="41dp"
            />

        <com.qurio.ui.components.SoundControl
            android:id="@+id/music_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:soundTitle="@string/music"
            app:soundIcon="@drawable/ic_music"
            app:soundLevel="0.8"
            app:layout_constraintTop_toBottomOf="@id/sound_bar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="26dp"
            />

        <ImageView
            android:id="@+id/divider"
            android:src="@drawable/divider"
            android:layout_width="match_parent"
            android:layout_height="10dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/music_bar"
            android:layout_marginTop="28dp"
            android:layout_marginHorizontal="12dp"
            />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@+id/divider"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="36dp"
            >

            <com.qurio.ui.components.QurioButtons
                android:id="@+id/save_changes_button"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="50dp"
                />

            <com.qurio.ui.components.QurioButtons
                android:id="@+id/discard_button"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="50dp"
                />

        </LinearLayout>


    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>