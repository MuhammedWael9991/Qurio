<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    >

<!--     primary    -->
    <!-- big -->
    <ImageView
        android:id="@+id/button_primary_big"
        android:src="@drawable/button_primary_big"
        android:layout_width="175dp"
        android:layout_height="67dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:visibility="gone"
        />

    <!-- small -->
    <ImageView
        android:id="@+id/button_primary_small"
        android:src="@drawable/button_primary_small"
        android:layout_width="175dp"
        android:layout_height="67dp"
        app:layout_constraintTop_toBottomOf="@id/button_primary_big"
        app:layout_constraintStart_toStartOf="parent"
        android:visibility="gone"
        />

    <!-- disabled -->
    <FrameLayout
        android:id="@+id/button_primary_disabled"
        android:layout_width="98dp"
        android:layout_height="44dp"
        app:layout_constraintTop_toBottomOf="@id/button_primary_small"
        app:layout_constraintStart_toStartOf="parent"
        android:background="@drawable/button_primary_disabled"
        android:layout_marginStart="40dp"
        android:visibility="gone"
        >

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"

            >

            <TextView
                style="@style/Typography.label.medium"
                android:textColor="@color/Shade_Secondary"
                android:text="@string/submit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginVertical="11dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="8dp"
                android:layout_gravity="center_vertical"
                />

            <ImageView
                android:src="@drawable/ic_setting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:layout_gravity="center_vertical"
                />

        </LinearLayout>

    </FrameLayout>




<!--     outlined    -->
    <!-- Enabled -->
    <FrameLayout
        android:id="@+id/button_outlined_enabled"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:background="@drawable/button_outlined"
        android:visibility="gone"
        >

        <TextView
            android:id="@+id/button_title_outlined_enabled"
            style="@style/Typography.label.medium"
            android:textColor="@color/Primary"
            android:text="@string/submit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginVertical="11dp"
            android:layout_marginHorizontal="12dp"
            />

    </FrameLayout>

    <!-- Disabled -->
    <FrameLayout
        android:id="@+id/button_outlined_disabled"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:background="@drawable/button_outlined"
        android:visibility="gone"
        >

        <TextView
            android:id="@+id/button_title_outlined_disabled"
            style="@style/Typography.label.medium"
            android:textColor="@color/Shade_Quad"
            android:text="@string/submit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginVertical="11dp"
            android:layout_marginHorizontal="12dp"
            />

    </FrameLayout>



<!--     Game    -->
    <!-- Enabled -->
    <TextView
        style="@style/Typography.label.medium"
        android:id="@+id/button_text_enabled"
        android:textColor="@color/Primary"
        android:text="@string/submit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:visibility="gone"
        />

    <!-- Disabled -->
    <TextView
        style="@style/Typography.label.medium"
        android:id="@+id/button_text_disabled"
        android:textColor="@color/Shade_Quad"
        android:text="@string/submit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:visibility="gone"
        />



<!--     Game Button   -->
    <!--     Big    -->
    <ImageView
        android:id="@+id/button_playnow_big"
        android:contentDescription="@string/play_now"
        android:src="@drawable/button_playnow_big"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:visibility="gone"
        />

    <!--     Small    -->
    <ImageView
        android:id="@+id/button_playnow_small"
        android:contentDescription="@string/play_now"
        android:src="@drawable/button_playnow_small"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:visibility="gone"
        />


</androidx.constraintlayout.widget.ConstraintLayout>