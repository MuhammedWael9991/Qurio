<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:background="@drawable/question_container"
        android:layout_marginTop="125dp"
        >

        <TextView
            android:id="@+id/reward_text"
            style="@style/Typography.title.small"
            android:textColor="@color/Shade_Primary"
            android:text="@string/reward"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="59dp"
            />

        <LinearLayout
            android:id="@+id/points_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/reward_text"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="2dp"
            >

            <ImageView
                android:id="@+id/point_icon"
                android:src="@drawable/ic_coins"
                android:layout_width="40dp"
                android:layout_height="40dp"/>

            <TextView
                android:id="@+id/point_number"
                style="@style/Typography.title.medium"
                android:textColor="@color/Shade_Primary"
                android:text="TODO"
                tools:text="500"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginBottom="3dp"
                />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/points_container"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginVertical="32dp"
            >

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/result_info_background"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="8dp"
                >

                <TextView
                    android:id="@+id/correct_text"
                    style="@style/Typography.body.small"
                    android:textColor="@color/Shade_Secondary"
                    android:text="@string/correct"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="4dp"
                    />

                <TextView
                    android:id="@+id/correct_number"
                    style="@style/Typography.label.medium"
                    android:textColor="@color/Shade_Primary"
                    android:text="TODO"
                    tools:text="10"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"

                    />

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/result_info_background"
                android:layout_marginEnd="8dp">

                <TextView
                    android:id="@+id/incorrect_text"
                    style="@style/Typography.body.small"
                    android:textColor="@color/Shade_Secondary"
                    android:text="@string/incorrect"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="4dp"
                    />

                <TextView
                    android:id="@+id/incorrect_number"
                    style="@style/Typography.label.medium"
                    android:textColor="@color/Shade_Primary"
                    android:text="TODO"
                    tools:text="2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"

                    />

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/result_info_background"
                android:layout_marginEnd="12dp"
                >

                <TextView
                    android:id="@+id/skipped_text"
                    style="@style/Typography.body.small"
                    android:textColor="@color/Shade_Secondary"
                    android:text="@string/skipped"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="4dp"

                    />

                <TextView
                    android:id="@+id/skipped_number"
                    style="@style/Typography.label.medium"
                    android:textColor="@color/Shade_Primary"
                    android:text="TODO"
                    tools:text="0"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"

                    />

            </LinearLayout>

        </LinearLayout>




    </androidx.constraintlayout.widget.ConstraintLayout>

    <ImageView
        android:id="@+id/result_header_glow"
        android:src="@drawable/result_header_glow"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:scaleType="centerCrop"
        />

    <ImageView
        android:id="@+id/result_header"
        android:src="@drawable/result_header"
        android:layout_width="match_parent"
        android:layout_height="90dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:scaleType="centerCrop"
        android:layout_marginTop="100dp"
        />

    <TextView
        android:id="@+id/result_title"
        style="@style/Typography.headline.medium"
        android:textColor="@color/On_primary"
        android:text="Great Job"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="@id/result_header"
        app:layout_constraintBottom_toBottomOf="@id/result_header"
        app:layout_constraintStart_toStartOf="@id/result_header"
        app:layout_constraintEnd_toEndOf="@id/result_header"
        android:layout_marginBottom="20dp"
        android:shadowColor="#1980B2"
        android:shadowDx="0"
        android:shadowDy="8"
        android:shadowRadius="1"
        />

    <include
        layout="@layout/game_stars"
        android:id="@+id/game_stars"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/result_header"
        android:layout_marginBottom="20dp"
        />

</androidx.constraintlayout.widget.ConstraintLayout>