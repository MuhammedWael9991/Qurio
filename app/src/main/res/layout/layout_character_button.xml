<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    >

    <!-- Confirm - Cancel -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/confirm_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:visibility="visible"
        >
        <FrameLayout
            android:id="@+id/confirm_button"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintDimensionRatio="3.5:1"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/cancel_button"
            android:background="@drawable/primary_button_bg"
            >

            <TextView
                style="@style/Typography.label.large"
                android:id="@+id/confirm_text"
                android:text="@string/confirm"
                android:textColor="@color/On_primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                />

        </FrameLayout>

        <FrameLayout
            android:id="@+id/cancel_button"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintDimensionRatio="3.5:1"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@id/confirm_button"
            app:layout_constraintEnd_toEndOf="parent"
            android:background="@drawable/button_outlined"
            android:layout_marginStart="8dp"
            >

            <TextView
                style="@style/Typography.label.large"
                android:id="@+id/cancel_text"
                android:text="@string/cancel"
                android:textColor="@color/Primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                />

        </FrameLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- OK -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ok_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:visibility="gone"
        >
        <FrameLayout
            android:id="@+id/ok_button"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintDimensionRatio="6.5:1"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:background="@drawable/button_outlined"
            >

            <TextView
                style="@style/Typography.label.large"
                android:id="@+id/ok_text"
                android:text="@string/ok"
                android:textColor="@color/Primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                />

        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Buy - OK -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/buy_ok_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:visibility="gone"
        >
        <FrameLayout
            android:id="@+id/buy_button"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintDimensionRatio="3.5:1"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/ok_buy_button"
            android:background="@drawable/primary_button_bg"
            >

            <TextView
                style="@style/Typography.label.large"
                android:id="@+id/buy_text"
                android:text="@string/buy"
                android:textColor="@color/On_primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                />

        </FrameLayout>

        <FrameLayout
            android:id="@+id/ok_buy_button"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintDimensionRatio="3.5:1"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@id/buy_button"
            app:layout_constraintEnd_toEndOf="parent"
            android:background="@drawable/button_outlined"
            android:layout_marginStart="8dp"
            >

            <TextView
                style="@style/Typography.label.large"
                android:id="@+id/ok_buy_text"
                android:text="@string/ok"
                android:textColor="@color/Primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                />

        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Buy - Cancel -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/buy_cancel_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:visibility="gone"
        >
        <FrameLayout
            android:id="@+id/buy_cancel_button"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintDimensionRatio="3.5:1"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/buy_character_cancel_button"
            android:background="@drawable/primary_button_bg"
            >

            <TextView
                style="@style/Typography.label.large"
                android:id="@+id/buy_txt"
                android:text="@string/buy"
                android:textColor="@color/On_primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                />

        </FrameLayout>

        <FrameLayout
            android:id="@+id/buy_character_cancel_button"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintDimensionRatio="3.5:1"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@id/buy_cancel_button"
            app:layout_constraintEnd_toEndOf="parent"
            android:background="@drawable/button_outlined"
            android:layout_marginStart="8dp"
            >

            <TextView
                style="@style/Typography.label.large"
                android:id="@+id/cancel_buy_txt"
                android:text="@string/cancel"
                android:textColor="@color/Primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                />

        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>