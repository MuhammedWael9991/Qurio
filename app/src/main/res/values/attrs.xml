<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Qurio Button -->
    <declare-styleable name="QuiroButtons">
        <attr name="buttonType" format="enum">
            <enum name="primary_big" value="0"/>
            <enum name="primary_small" value="1"/>
            <enum name="primary_disabled" value="2"/>
            <enum name="outlined_enabled" value="3"/>
            <enum name="outlined_disabled" value="4"/>
            <enum name="game_text_enabled" value="5"/>
            <enum name="game_text_disabled" value="6"/>
        </attr>
        <attr name="onButtonClick" format="reference" />
        <attr name="buttonText" format="string" />
    </declare-styleable>

    <!-- Character Dialog Buttons -->
    <declare-styleable name="CharacterButtons">
        <attr name="buttonsType" format="enum">
            <enum name="confirm_cancel" value="0"/>
            <enum name="ok" value="1"/>
            <enum name="buy_ok" value="2"/>
            <enum name="buy_cancel" value="3"/>
        </attr>
    </declare-styleable>

    <!-- Top Bar -->
    <declare-styleable name="TopBarView">
        <attr name="topBarType" format="enum">
            <enum name="primary" value="0" />
            <enum name="secondary" value="1" />
        </attr>
        <attr name="topBarTitle" format="string"/>
    </declare-styleable>

    <!-- Sound Bar -->
    <declare-styleable name="SoundControlView">
        <attr name="soundTitle" format="string" />
        <attr name="soundIcon" format="reference" />
        <attr name="soundLevel" format="float" />
    </declare-styleable>

</resources>
