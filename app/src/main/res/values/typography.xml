<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base Typography style -->
    <style name="Typography" />

    <!-- Headline / Title -->
    <style name="Typography.headline" parent="Typography">
        <item name="fontFamily">@font/fredoka_semibold</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Body -->
    <style name="Typography.body" parent="Typography">
        <item name="fontFamily">@font/fredoka_regular</item>
    </style>

    <!-- Label -->
    <style name="Typography.lable" parent="Typography">
        <item name="fontFamily">@font/fredoka_medium</item>
    </style>

    <!-- Headline -->
    <!-- Headline / large -->
    <style name="Typography.headline.large" parent="Typography.headline">
        <item name="android:textSize">28sp</item>
        <item name="lineHeight">42sp</item>
    </style>

    <!-- Headline / Medium -->
    <style name="Typography.headline.medium" parent="Typography.headline">
        <item name="android:textSize">24sp</item>
        <item name="lineHeight">36sp</item>
    </style>

    <!-- Headline / Small -->
    <style name="Typography.headline.small" parent="Typography.headline">
        <item name="android:textSize">20sp</item>
        <item name="lineHeight">30sp</item>
    </style>


    <!-- Title -->
    <!-- Title / large -->
    <style name="Typography.title.large" parent="Typography.headline">
        <item name="android:textSize">20sp</item>
        <item name="lineHeight">30sp</item>
    </style>

    <!-- Title / Medium -->
    <style name="Typography.title.medium" parent="Typography.headline">
        <item name="android:textSize">18sp</item>
        <item name="lineHeight">28sp</item>
    </style>

    <!-- Title / Small -->
    <style name="Typography.title.small" parent="Typography.headline">
        <item name="android:textSize">16sp</item>
        <item name="lineHeight">24sp</item>
    </style>


    <!-- Body -->
    <!-- Body / large -->
    <style name="Typography.body.large" parent="Typography.body">
        <item name="android:textSize">18sp</item>
        <item name="lineHeight">28sp</item>
    </style>

    <!-- Body / Medium -->
    <style name="Typography.body.medium" parent="Typography.body">
        <item name="android:textSize">16sp</item>
        <item name="lineHeight">24sp</item>
    </style>

    <!-- Body / Small -->
    <style name="Typography.body.small" parent="Typography.body">
        <item name="android:textSize">14sp</item>
        <item name="lineHeight">22sp</item>
    </style>

    <!-- Label -->
    <!-- Label / large -->
    <style name="Typography.label.large" parent="Typography.lable">
        <item name="android:textSize">16sp</item>
        <item name="lineHeight">24sp</item>
    </style>

    <!-- Label / Medium -->
    <style name="Typography.label.medium" parent="Typography.lable">
        <item name="android:textSize">14sp</item>
        <item name="lineHeight">22sp</item>
    </style>

    <!-- Label / Small -->
    <style name="Typography.label.small" parent="Typography.lable">
        <item name="android:textSize">10sp</item>
        <item name="lineHeight">16sp</item>
    </style>

    <!-- Label / XSmall -->
    <style name="Typography.label.xsmall" parent="Typography.lable">
        <item name="android:textSize">10sp</item>
        <item name="lineHeight">14sp</item>
    </style>

</resources>